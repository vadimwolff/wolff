android-app/app/build/
android-app/.gradle/
android-app/build/
android-app/local.properties
android-app/app/src/main/assets/
android-app/app/src/main/res/drawable/ic_launcher_fg.png
android-app/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png
android.keystore
out/
